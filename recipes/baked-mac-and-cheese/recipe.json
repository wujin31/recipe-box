  "steps": [
    {
      "text": "Heat the oven to 190°C and butter a 23 × 33 cm baking dish.",
      "ingredientRefs": [],
      "timers": []
    },
    {
      "text": "Boil 450 g elbow macaroni or cavatappi in water with 1 tbsp salt (for the pasta water) 2 minutes less than the package says. Drain and rinse briefly to stop the cooking.",
      "ingredientRefs": [
        0,
        1
      ],
      "timers": []
    },
    {
      "text": "Melt 6 tbsp butter in a large pot over medium. Whisk in 45 g all-purpose flour and cook 2 minutes, until bubbling but not browned.",
      "ingredientRefs": [
        2,
        3
      ],
      "timers": [
        {
          "text": "2 minutes",
          "seconds": 120
        }
      ]
    },
    {
      "text": "Slowly whisk in 950 ml whole milk, warmed, then add 1 tsp dry mustard powder, 1/2 tsp smoked paprika, 1/8 tsp cayenne pepper, 1 1/2 tsp salt and 1/2 tsp black pepper. Simmer 5 minutes, whisking, until it coats a spoon.",
      "ingredientRefs": [
        4,
        5,
        6,
        7,
        8,
        9
      ],
      "timers": [
        {
          "text": "5 minutes",
          "seconds": 300
        }
      ]
    },
    {
      "text": "Off the heat, stir in 340 g extra-sharp cheddar, grated and 115 g Gruyère, grated until smooth. Fold in the pasta and pour into the dish.",
      "ingredientRefs": [
        10,
        11
      ],
      "timers": []
    },
    {
      "text": "Toss 50 g panko with 2 tbsp butter, melted (for the topping) and 30 g Parmesan, grated and scatter over the top.",
      "ingredientRefs": [
        12,
        13,
        14
      ],
      "timers": []
    },
    {
      "text": "Bake 25 minutes, until bubbling at the edges and golden on top. Rest 10 minutes before serving.",
      "ingredientRefs": [],
      "timers": [
        {
          "text": "25 minutes",
          "seconds": 1500
        },
        {
