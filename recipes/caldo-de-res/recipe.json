        {
          "text": "2 hours",
          "seconds": 7200
        }
      ]
    },
    {
      "text": "Blend 2 Roma tomatoes with a ladle of broth and stir it into the pot.",
      "ingredientRefs": [
        7
      ],
      "timers": []
    },
    {
      "text": "Add 3 ears corn, cut into 5 cm pieces, 3 carrots, cut into chunks and 3 potatoes, quartered and simmer 15 minutes.",
      "ingredientRefs": [
        8,
        9,
        10
      ],
      "timers": [
        {
          "text": "15 minutes",
          "seconds": 900
        }
      ]
    },
    {
      "text": "Add 2 chayotes, cut into wedges and simmer 10 minutes, then add 2 Mexican squash or zucchini, cut into chunks, 1/4 green cabbage, cut into wedges and 4 sprigs cilantro and simmer 8 minutes more, until everything is tender. Taste for salt.",
      "ingredientRefs": [
        11,
