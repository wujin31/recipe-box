  "steps": [
    {
      "text": "Whisk 180 ml shoyu (soy sauce), 150 g brown sugar, 120 ml water, 60 ml mirin, 2 tbsp grated ginger, 4 garlic cloves, grated, 3 tbsp pineapple juice, 1 tsp toasted sesame oil and 1 tsp black pepper until the sugar dissolves. Set aside 120 ml for the glaze. Add 900 g chuck flap, top sirloin or flank steak, sliced 6 mm thick against the grain to the rest, cover and refrigerate overnight (at least 4 hours).",
      "ingredientRefs": [
        0,
