    },
    {
      "text": "Pat 680 g firm white fish (cod, halibut, rockfish or mahi-mahi), cut into 2 × 10 cm strips dry and season with 1 tsp salt (for the fish).",
      "ingredientRefs": [
        0,
        1
      ],
      "timers": []
    },
    {
      "text": "Whisk 130 g all-purpose flour, 1/2 tsp baking powder, 1 tsp salt (for the batter) and 1/2 tsp Mexican oregano. Add 1 tsp yellow mustard and 250 ml cold Mexican lager and whisk just until smooth, like thin pancake batter. Don't overmix.",
      "ingredientRefs": [
        2,
        3,
        4,
        5,
        6,
        7
      ],
      "timers": []
    },
    {
      "text": "Heat 1 L neutral oil (for frying) in a deep pot to 185°C.",
      "ingredientRefs": [
        9
      ],
      "timers": []
    },
    {
      "text": "Dust the fish strips in 40 g all-purpose flour (for dredging), dip in the batter and let the excess drip off, then lower them into the oil away from you. Fry 4 at a time for 4 minutes, turning once, until deep golden and crisp. Drain on a rack.",
      "ingredientRefs": [
        8
      ],
      "timers": [
        {
          "text": "4 minutes",
          "seconds": 240
        }
      ]
    },
    {
      "text": "Warm 12 corn tortillas on a hot comal or dry pan for 30 seconds per side, stacking them in a towel.",
      "ingredientRefs": [
        21
      ],
      "timers": [
        {
          "text": "30 seconds",
          "seconds": 30
        }
      ]
    },
    {
      "text": "Put a piece of fish in each tortilla (doubled if thin), top with 200 g green cabbage, very finely shredded, a drizzle of crema and salsa, and serve with 2 limes, cut into wedges.",
      "ingredientRefs": [
        20,
